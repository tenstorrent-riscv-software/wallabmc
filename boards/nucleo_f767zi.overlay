// Nucleo F767ZI

#include "nucleo_f767zi_wallabmc.dtsi"

/*
 * Zephyr's flash layout for the board, with a smaller MCUboot partition
 * and the space that frees given to settings storage. The two image slots
 * (3*256 kbytes each, at 0x40000 and 0x100000) are as Zephyr has them.
 */

/* Sector 0 (32 kbytes) for mcuboot */
&boot_partition {
    reg = <0x00000000 DT_SIZE_K(32)>;
};

/*
 * Sectors 1-3 (3*32 kbytes) for NVS storage. The node keeps the name
 * Zephyr gave it, so it shows up as partition@10000 in zephyr.dts.
 */
&storage_partition {
    reg = <0x00008000 DT_SIZE_K(96)>;
};
