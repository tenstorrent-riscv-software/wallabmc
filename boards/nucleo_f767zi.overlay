/delete-node/ &quadspi_memory;

// Nucleo F767ZI
/ {
    chosen {
        zephyr,rtc = &rtc;
    };

    jtag {
        // What is a better setting for this?
        compatible = "gpio-leds";

        jtagtck: jtag_tck {
            gpios = <&gpioe  2 GPIO_ACTIVE_HIGH>;
        };
        jtagtms: jtag_tms {
            gpios = <&gpioe  3 GPIO_ACTIVE_HIGH>;
        };
        jtagtdo: jtag_tdo {
            gpios = <&gpioe  5     GPIO_PULL_UP>;
        };
        jtagtdi: jtag_tdi {
            gpios = <&gpioe  6 GPIO_ACTIVE_HIGH>;
        };
    };

    // Zephyr configures ACTIVE_LOW by default, which reads 0 when the
    // button is pressed and 1 when it is released. Flip to 1 on press.
    gpio_keys {
        compatible = "gpio-keys";

        user_button: button_0 {
            label = "User";
            gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>;
            zephyr,code = <INPUT_KEY_0>;
        };
    };

    aliases {
        jtagtck = &jtagtck;
        jtagtms = &jtagtms;
        jtagtdi = &jtagtdi;
        jtagtdo = &jtagtdo;

        power-led = &green_led;
        status-led = &blue_led;

        reset-button = &user_button;
	host-console-uart = &usart6;
    };
};

&spi4 {
     status = "disabled";
};

&die_temp {
    status = "okay";
};

&usart6 {
	current-speed = <115200>;
	status = "okay";
};

/delete-node/ &boot_partition;
/delete-node/ &storage_partition;
/delete-node/ &slot0_partition;
/delete-node/ &slot1_partition;
/delete-node/ &scratch_partition;

&flash0 {
/*
 * MCUboot's sysbuild CMake wants erase-block-size on the flash node to
 * estimate the image trailer size and warns if it is missing. Zephyr
 * omits it for STM32F7 because the sectors are not uniform (4x32K,
 * 1x128K, 7x256K). Use the largest sector as a safe upper bound. Only
 * MCUboot's build sees this; the flash driver has its own sector table.
 * And the slot0 and slot1 partitions that mcuboot uses do have uniform
 * 256K blocks.
 */
    erase-block-size = <DT_SIZE_K(256)>;

    partitions {
        #address-cells = <1>;
        #size-cells = <1>;
        ranges;

        boot_partition: partition@0 {
            compatible = "zephyr,mapped-partition";
            label = "mcuboot";
            reg = <0x00000000 DT_SIZE_K(32)>;
        };

        /* 3*32KB, enough for NVS storage */
        storage_partition: partition@8000 {
            compatible = "zephyr,mapped-partition";
            label = "storage";
            reg = <0x00008000 DT_SIZE_K(96)>;
        };

	/* Unused 128K block */

        slot0_partition: partition@40000 {
            compatible = "zephyr,mapped-partition";
            label = "image-0";
            reg = <0x00040000 DT_SIZE_K(768)>;
        };

        slot1_partition: partition@100000 {
            compatible = "zephyr,mapped-partition";
            label = "image-1";
            reg = <0x00100000 DT_SIZE_K(768)>;
        };

        scratch_partition: partition@1c0000 {
            compatible = "zephyr,mapped-partition";
            label = "image-scratch";
            reg = <0x001c0000 DT_SIZE_K(256)>;
        };
	/* Unused 256K block */
    };
};
